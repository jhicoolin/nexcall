{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MISATO",
  "version": "0.1.0",
  "identifier": "com.nexcall.misato",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000/login",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../desktop-shell"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "MISATO Mission Control",
        "width": 1440,
        "height": 920,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
