# Core site
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
NEXT_PUBLIC_TWILIO_PHONE_NUMBER="+18662015543"
NEXT_PUBLIC_DEMO_PHONE_NUMBER="+15551234567"
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Database / Prisma / Supabase Postgres
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"
SECRET_ENCRYPTION_KEY="generate-32-random-bytes-as-base64-or-64-hex-chars"

# Admin dashboard
ADMIN_DASHBOARD_TOKEN="make-a-long-random-admin-token"
ADMIN_SESSION_SECRET="make-a-different-long-random-session-secret"
CLIENT_DIRECTORY_READ_TOKEN="make-a-long-random-token"

# Rate limiting / cost protection
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
# Vercel KV / Upstash integration aliases are also supported:
KV_REST_API_URL="https://your-vercel-kv-instance.upstash.io"
KV_REST_API_TOKEN="your-vercel-kv-token"

# Twilio
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_MEDIA_STREAM_URL="wss://your-media-server.example.com/twilio-media"
MEDIA_SERVER_PORT="8080"
MEDIA_SERVER_PATH="/twilio-media"

# AI turn endpoint and provider tokens
AI_TURN_ENDPOINT="https://your-domain.com/api/ai/respond"
AI_TURN_API_TOKEN="make-a-long-random-token"
# Legacy native voice-engine provider variables are intentionally omitted from
# launch setup. Prefer ElevenLabs outbound calls or Vapi for production voice.

# Production voice provider
DEFAULT_VOICE_PROVIDER="VAPI"
VAPI_API_KEY=""
VAPI_WEBHOOK_SECRET="make-a-long-random-vapi-webhook-secret"
VAPI_MODEL_PROVIDER="openai"
VAPI_MODEL="gpt-4o-mini"
VAPI_TRANSCRIBER_PROVIDER="deepgram"
VAPI_TRANSCRIBER_MODEL="nova-3"
VAPI_VOICE_PROVIDER="11labs"
VAPI_VOICE_ID="default"

# Inngest background jobs
